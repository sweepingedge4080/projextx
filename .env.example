# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/sparklotto?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=7d

# Admin
ADMIN_EMAIL=admin@sparklotto.io

# Withdrawal wallets (where users send deposits)
DEPOSIT_WALLET_USDT_TRC20=T_PLACEHOLDER
DEPOSIT_WALLET_USDT_ERC20=0xPLACEHOLDER

# House cut (percent)
HOUSE_CUT_PERCENT=17
